# =============================================================================
# Production environment for docker-compose. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Public site URLs (one per landing). Used at BUILD TIME for canonical, OG,
# sitemap, JSON-LD. Must match the public domains nginx terminates SSL on.
# -----------------------------------------------------------------------------
SITE_URL_MAX=https://max.example.ru
SITE_URL_TG=https://tg.example.ru
SITE_URL_WEB=https://web.example.ru

# -----------------------------------------------------------------------------
# Search-engine analytics & verification.
# Optional — leave blank until you've registered the counter / verified a site.
# -----------------------------------------------------------------------------
# Yandex.Metrika counter id (just digits, e.g. 12345678).
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Token from Яндекс.Вебмастер ("Подтверждение прав на сайт" → meta-tag).
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Token from Google Search Console ("HTML-tag" verification method).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# -----------------------------------------------------------------------------
# Yandex SmartCaptcha. Get the key pair at
#   https://console.cloud.yandex.ru/folders/<folder>/smartcaptcha
# Leave SERVER_KEY blank to skip captcha verification (dev / first-deploy).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# -----------------------------------------------------------------------------
# Backend (Go lead-service). All three frontends proxy /api/lead → backend
# via Docker DNS as http://backend:8080.
# -----------------------------------------------------------------------------

# CSV of allowed CORS origins. Must list every public frontend URL exactly.
ALLOWED_ORIGINS=https://max.example.ru,https://tg.example.ru,https://web.example.ru

# Per-IP rate limit (requests per minute). 5 is sane for a contact form.
RATE_LIMIT_PER_MIN=5

# -----------------------------------------------------------------------------
# Telegram notifications. Create a bot via @BotFather, add it to your group,
# copy the token + chat id (chat id is negative for groups).
# Leave TELEGRAM_BOT_TOKEN blank to log leads to stdout only.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
