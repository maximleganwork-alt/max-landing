# Server
PORT=8080
# CSV list of allowed origins (one per landing)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Telegram (single bot, supergroup with three topics)
TELEGRAM_BOT_TOKEN=xxx:xxx
TELEGRAM_CHAT_ID=-1001234567890
# Per-source forum thread IDs (empty = post to General)
TELEGRAM_THREAD_ID_MAX=
TELEGRAM_THREAD_ID_TG=
TELEGRAM_THREAD_ID_WEB=

# Yandex SmartCaptcha
SMARTCAPTCHA_SERVER_KEY=xxx

# Rate limit
RATE_LIMIT_PER_MIN=5
